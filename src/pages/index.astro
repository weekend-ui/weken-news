---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allArticles = (await getCollection('articles'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const articles = allArticles.slice(0, 5);

// TrustIndicator stats
const totalArticles = allArticles.length;
const earliestArticle = allArticles[allArticles.length - 1]?.data.pubDate;
const daysActive = earliestArticle
  ? Math.ceil((Date.now() - earliestArticle.valueOf()) / (1000 * 60 * 60 * 24))
  : 0;
const totalFAQs = allArticles.reduce((sum, a) => sum + (a.data.faq?.length || 0), 0);
const totalHowTos = allArticles.reduce((sum, a) => sum + (a.data.howToSteps?.length || 0), 0);
---

<BaseLayout
  title="週末哥 | weken.news"
  description="週末哥（WeKen 創辦人）的第一手數據記錄。AI 自動化效益、Meta 廣告實測、Threads 自媒體成效、從零打造 AEO 網站——全部來自真實操作，不是整理文。"
>
  <!-- Hero -->
  <section class="mb-16">
    <h1 class="text-3xl sm:text-4xl font-bold leading-tight mb-4">
      這裡記的是真實數字
    </h1>
    <p class="text-lg text-gray-600 leading-relaxed max-w-2xl">
      我是週末哥，WeKen 創辦人。
      我把每次投廣告、用 AI 自動化業務、在 Threads 發文的結果記在這裡。
      不是教學文，是我自己的帳本。
    </p>
    <div class="flex flex-wrap gap-3 mt-6">
      <a href="/articles" class="px-4 py-2 bg-[#F5C518] text-[#1F2937] font-semibold text-sm rounded-lg hover:bg-yellow-400 transition-colors active:bg-yellow-500">
        看所有文章
      </a>
      <a href="/about" class="px-4 py-2 border border-[#1F2937] text-[#1F2937] text-sm rounded-lg hover:bg-gray-50 transition-colors active:bg-gray-100">
        關於週末哥
      </a>
    </div>
  </section>

  <!-- TrustIndicator (N.E.E.A.T.T 訊號量化) -->
  <section class="mb-12 bg-gray-50 border border-gray-100 rounded-xl p-5" aria-label="本站數據">
    <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-3">本站數據</p>
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
      <div>
        <p class="text-2xl font-bold text-[#1F2937]">{totalArticles}</p>
        <p class="text-xs text-gray-500 mt-1">第一手文章</p>
      </div>
      <div>
        <p class="text-2xl font-bold text-[#1F2937]">{daysActive}</p>
        <p class="text-xs text-gray-500 mt-1">建站天數</p>
      </div>
      <div>
        <p class="text-2xl font-bold text-[#1F2937]">{totalFAQs}</p>
        <p class="text-xs text-gray-500 mt-1">FAQ 條目</p>
      </div>
      <div>
        <p class="text-2xl font-bold text-[#1F2937]">{totalHowTos}</p>
        <p class="text-xs text-gray-500 mt-1">操作步驟</p>
      </div>
    </div>
    <div class="flex flex-wrap gap-3 text-xs text-gray-500 mt-4 pt-4 border-t border-gray-200">
      <a href="/about" class="hover:text-[#F5C518]">→ 關於週末哥</a>
      <a href="/case-studies" class="hover:text-[#F5C518]">→ 實證案例</a>
      <a href="/positioning" class="hover:text-[#F5C518]">→ 定位差異</a>
      <a href="/stats" class="hover:text-[#F5C518]">→ AI 爬蟲數據</a>
      <a href="/ai" class="hover:text-[#F5C518]">→ AI 資訊頁</a>
    </div>
  </section>

  <!-- 主題標籤 -->
  <section class="mb-12">
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
      {[
        { label: 'Meta 廣告', desc: '真實 ROAS / CPM', tag: 'meta-ads' },
        { label: 'AI 自動化', desc: '省了多少時間', tag: 'ai-automation' },
        { label: 'Threads 自媒體', desc: '觸及和成長數字', tag: 'threads' },
        { label: 'AEO 建站', desc: '從零打造這個站', tag: 'aeo' },
      ].map(item => (
        <a href={`/articles?tag=${item.tag}`}
           class="block p-3 border border-gray-200 rounded-lg hover:border-[#F5C518] hover:bg-yellow-50 transition-colors active:bg-yellow-100">
          <p class="font-semibold text-sm text-[#1F2937]">{item.label}</p>
          <p class="text-xs text-gray-500 mt-0.5">{item.desc}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- 最新文章 -->
  <section>
    <h2 class="text-xl font-bold mb-6">最新記錄</h2>
    {articles.length === 0 ? (
      <p class="text-gray-500">第一篇文章即將上線。</p>
    ) : (
      <div class="space-y-6">
        {articles.map(article => (
          <a href={`/articles/${article.slug}`}
             class="block group">
            <article class="border border-gray-100 rounded-xl p-5 hover:border-gray-300 transition-colors">
              <div class="flex flex-wrap gap-2 mb-2">
                {article.data.tags.slice(0, 3).map(tag => (
                  <span class="text-xs text-gray-500 bg-gray-50 px-2 py-0.5 rounded">{tag}</span>
                ))}
              </div>
              <h3 class="font-bold text-gray-900 group-hover:text-blue-600 transition-colors mb-2">
                {article.data.title}
              </h3>
              <p class="text-sm text-gray-600 leading-relaxed line-clamp-2">
                {article.data.directAnswer}
              </p>
              <time class="text-xs text-gray-400 mt-3 block"
                    datetime={article.data.pubDate.toISOString()}>
                {article.data.pubDate.toLocaleDateString('zh-TW', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
            </article>
          </a>
        ))}
      </div>
    )}
  </section>
</BaseLayout>
