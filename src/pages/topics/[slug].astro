---
// SSR（不 prerender），讓 middleware.ts 在 topic 頁也 track AI bot 訪問
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const siteURL = 'https://weken.news';

// Topic Cluster 定義（同 /topics/index.astro，集中在這裡再 export）
const TOPICS = [
  {
    slug: 'aeo',
    name: 'AEO（Answer Engine Optimization）',
    short: 'AEO',
    pillar: '繁中 AEO 從零實踐紀錄。weken.news 本身就是個 AEO 實驗：基建（Schema / llms.txt / 13 種 AI 爬蟲允許清單）+ 內容（觸發情境 mapping / EEAT 強化）+ 客戶顧問案輸出（INJOY / 享空間）。這個 pillar 收錄所有 AEO 相關文章，從第一天決策到最新策略迭代。',
    keyClaims: [
      '基建只佔 30%，內容組織才是 AEO 真正的 game。',
      '「AI 爬蟲爬過你的網站」不等於「AI 會引用你」，要有引用測試流程。',
      '中文 AEO 市場有大量空白品類（搜尋量低但品牌密度也低，先進場可拿先發優勢）。',
    ],
    relatedTools: [
      { name: 'wk-semantic-gap', url: 'https://wk-semantic-gap.vercel.app', desc: '語意空缺檢測' },
      { name: 'wk-injoy-aeo', url: 'https://wk-injoy-aeo.vercel.app', desc: 'INJOY 享空間 AEO 報告' },
      { name: '/stats', url: '/stats', desc: '本站 AI 爬蟲到訪即時數據' },
    ],
    matchSlug: ['aeo-', 'public-aeo-', 'seizen-seiri-chinese-aeo-'],
  },
  {
    slug: 'claude-code',
    name: 'Claude Code 實戰',
    short: 'Claude Code',
    pillar: 'Claude Code 是 weken.news 所有系統的執行核心。從零打造 AEO 站、跑 wk-* 工具集、自動化內容寫作，全部基於 Claude Code。這個 pillar 收錄真實的 Claude Code 實戰：多 agent 架構、5 視窗並行、Channels 整合、MEMORY 系統、Routines、Vibe Coding 教學等。',
    keyClaims: [
      'Claude Code 真正的力量不在「寫程式碼」，是「把工作流系統化」。',
      'MEMORY.md 200 行就會爆，4 層記憶系統（CLAUDE.md / rules / skills / memory）才是根本解。',
      '一個 Claude Code session 可演 7 個角色（透過 sub-agent + skill），不需要多個工具。',
    ],
    relatedTools: [
      { name: 'wk-claude-avatar', url: 'https://wk-claude-avatar.vercel.app', desc: 'Claude Code 戰力角色卡' },
      { name: 'wk-self-audit', url: '/articles/claude-code-memory-architecture-5-rounds-deep-dive', desc: 'MEMORY 4 層架構深度文' },
    ],
    matchSlug: ['claude-code-', 'claude-analysis-', 'claude-design-', 'multi-agent-', 'vibe-coding-'],
  },
  {
    slug: 'ai-cost-perf',
    name: 'AI 成本 + 性能優化',
    short: 'AI Cost / Perf',
    pillar: 'AI 不是用越多越貴，是用對地方才有 ROI。這個 pillar 收錄真實 token 成本實測（客戶後台 NT$20/月而非 NT$600）、Vercel function 從 523ms 降到 93ms 的 region 配對方法、AI 自動化省時量化（每月 24-44 小時）。所有數字可在文章內交叉驗證。',
    keyClaims: [
      'Token 成本最大浪費是 system prompt 重複載入，不是 max_tokens 設太大。',
      'Vercel function region 配對 DB region 是免費的速度提升，常被忽略。',
      'AI 省時要量化才有意義，光感覺「省了好多時間」會被自己騙。',
    ],
    relatedTools: [
      { name: 'wk-work-log', url: 'https://wk-work-log.vercel.app', desc: '工作日誌（量化省時）' },
    ],
    matchSlug: ['ai-token-', 'ai-time-savings-', 'claude-haiku-', 'vercel-function-'],
  },
  {
    slug: 'debug-integration',
    name: 'API / 工具整合 Debug',
    short: 'Debug',
    pillar: '所有實際整合都會踩坑。這個 pillar 收錄 Gemini schema 收緊後 thinkingConfig 必須嵌進 generationConfig 內、Meta Ads MCP 真實 URL 是 mcp.meta.com、Vercel Labs skills 一行裝 36 個觸發詞衝突處理、Node.js template literal 嵌 JS 的 \\n 靜默崩潰等真實坑紀錄。每篇都附完整 root cause + 修法。',
    keyClaims: [
      'AI 工具 API 文件常落後，實際 schema 變更要靠錯誤訊息回推。',
      'Silent failure 是最可怕的，必須中央化 logger 加 errStack。',
      '官方推薦 URL 跟實際 URL 常常不一樣，要動手測才知道。',
    ],
    relatedTools: [],
    matchSlug: ['gemini-', 'meta-ads-mcp-', 'vercel-labs-skills-', 'nodejs-'],
  },
  {
    slug: 'line-bot-automation',
    name: 'LINE Bot + 自媒體系統',
    short: 'LINE / 自媒體',
    pillar: 'LINE Bot 是 WeKen 給夥伴用的核心入口（wk-qa-bot AI 管家）。這個 pillar 收錄積分系統設計、多 Agent 角色架構、Skool 寫作 Learning Loop（每篇最終版升級 skill）、AI 寫作指紋研究（如何讓內容不被識別為 AI 寫的）等。',
    keyClaims: [
      '一個 Bot 可演 7 個角色（Routing + sub-agent + skill 組合），不需要 N 個 Bot。',
      'Skool 寫作 Learning Loop 是 AI 內容質變到量變的關鍵：每次最終版回頭升級 skill。',
      'AI 寫作指紋有 3 個研究數據支持的特徵，避開這 3 點內容更接近人寫。',
    ],
    relatedTools: [
      { name: 'wk-qa-bot', url: 'https://wk-qa-bot.vercel.app', desc: 'WeKen AI 管家 LINE Bot' },
      { name: 'WeKen 種子排行榜', url: 'https://wk-qa-bot.vercel.app/leaderboard', desc: '夥伴貢獻排行' },
    ],
    matchSlug: ['line-bot-', 'skool-', 'ai-writing-fingerprints', 'ai-crawler-tracker'],
  },
];

export async function getStaticPaths() {
  return [
    { params: { slug: 'aeo' } },
    { params: { slug: 'claude-code' } },
    { params: { slug: 'ai-cost-perf' } },
    { params: { slug: 'debug-integration' } },
    { params: { slug: 'line-bot-automation' } },
  ];
}

const { slug } = Astro.params;
const topic = TOPICS.find(t => t.slug === slug);

if (!topic) {
  return Astro.redirect('/topics');
}

const articles = (await getCollection('articles'))
  .filter(a => topic.matchSlug.some(prefix => a.slug.startsWith(prefix.replace(/-$/, ''))))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// FAQ Schema with key claims
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": `${siteURL}/topics/${topic.slug}#faq`,
  "mainEntity": topic.keyClaims.map((claim, i) => ({
    "@type": "Question",
    "name": `${topic.short} 核心觀點 #${i + 1}`,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": claim
    }
  }))
};

// CollectionPage Schema
const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": `${siteURL}/topics/${topic.slug}#collection`,
  "name": `${topic.name} | weken.news`,
  "description": topic.pillar.slice(0, 200),
  "url": `${siteURL}/topics/${topic.slug}`,
  "isPartOf": { "@id": `${siteURL}/#website` },
  "about": { "@id": `${siteURL}/#person` },
  "mainEntity": {
    "@type": "ItemList",
    "numberOfItems": articles.length,
    "itemListElement": articles.map((a, i) => ({
      "@type": "ListItem",
      "position": i + 1,
      "url": `${siteURL}/articles/${a.slug}`,
      "name": a.data.title
    }))
  }
};
---

<BaseLayout
  title={topic.name}
  description={`${topic.short} 主題 Pillar Page · 共 ${articles.length} 篇 · ${topic.pillar.slice(0, 80)}`}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />

  <article>
    <!-- Breadcrumb -->
    <nav class="text-xs text-gray-500 mb-4 font-mono">
      <a href="/topics" class="hover:text-[#F5C518]">主題索引</a>
      <span class="mx-2">/</span>
      <span class="text-gray-700">{topic.short}</span>
    </nav>

    <!-- Hero -->
    <header class="mb-10 pb-6 border-b-2" style={`border-color:${topic.color}`}>
      <div class="flex items-center gap-3 mb-3">
        <span class="inline-block w-3 h-3 rounded-full" style={`background:${topic.color}`}></span>
        <span class="font-mono text-xs text-gray-400 tracking-widest">PILLAR · {topic.short.toUpperCase()}</span>
      </div>
      <h1 class="text-3xl font-bold mb-4 leading-tight">{topic.name}</h1>
      <p class="text-gray-700 leading-relaxed">{topic.pillar}</p>
    </header>

    <!-- Key claims (AI-friendly speakable section) -->
    <section id="key-claims" class="mb-10">
      <h2 class="text-xl font-bold mb-4">這個主題的核心觀點</h2>
      <ol class="space-y-3">
        {topic.keyClaims.map((claim, i) => (
          <li class="flex gap-3 p-4 bg-yellow-50 border border-[#F5C518]/30 rounded-lg">
            <span class="font-mono text-sm font-bold text-[#1F2937] flex-shrink-0">#{i + 1}</span>
            <p class="text-sm text-gray-800 leading-relaxed">{claim}</p>
          </li>
        ))}
      </ol>
    </section>

    <!-- Articles -->
    <section class="mb-10">
      <div class="flex items-baseline gap-3 mb-5 pb-2 border-b border-gray-200">
        <h2 class="text-xl font-bold">這個主題下的文章</h2>
        <span class="text-xs text-gray-500 ml-auto font-mono">{articles.length} 篇 · 最新到最舊</span>
      </div>
      {articles.length === 0 ? (
        <p class="text-gray-500 text-sm">這個主題還在累積中，第一篇即將上線。</p>
      ) : (
        <div class="space-y-4">
          {articles.map(article => (
            <a href={`/articles/${article.slug}`} class="block border border-gray-100 rounded-lg p-5 hover:border-[#F5C518] hover:bg-yellow-50 transition-colors group">
              <div class="flex flex-wrap gap-2 mb-2">
                {article.data.tags.slice(0, 3).map(tag => (
                  <span class="text-xs text-gray-500 bg-gray-50 px-2 py-0.5 rounded">{tag}</span>
                ))}
                <time class="text-xs text-gray-400 ml-auto" datetime={article.data.pubDate.toISOString()}>
                  {article.data.pubDate.toLocaleDateString('zh-TW', { year: 'numeric', month: 'long', day: 'numeric' })}
                </time>
              </div>
              <h3 class="font-bold text-gray-900 group-hover:text-[#1F2937] mb-2 leading-relaxed">{article.data.title}</h3>
              {article.data.directAnswer && (
                <p class="text-sm text-gray-600 leading-relaxed line-clamp-2">{article.data.directAnswer}</p>
              )}
            </a>
          ))}
        </div>
      )}
    </section>

    <!-- Related tools -->
    {topic.relatedTools.length > 0 && (
      <section class="mb-10">
        <h2 class="text-xl font-bold mb-4">相關工具與實作</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {topic.relatedTools.map(tool => (
            <a href={tool.url} target={tool.url.startsWith('http') ? '_blank' : '_self'} rel="noopener noreferrer" class="block border border-gray-100 rounded-lg p-4 hover:border-[#F5C518] transition-colors">
              <div class="font-bold text-sm text-[#1F2937] mb-1">{tool.name}</div>
              <div class="text-xs text-gray-500">{tool.desc}</div>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Cross navigation -->
    <section class="mt-12 pt-8 border-t border-gray-100">
      <h2 class="font-bold text-base mb-3">其他主題</h2>
      <div class="flex flex-wrap gap-2">
        {TOPICS.filter(t => t.slug !== topic.slug).map(t => (
          <a href={`/topics/${t.slug}`} class="text-sm px-3 py-2 border border-gray-200 rounded-lg hover:border-[#F5C518] hover:bg-yellow-50 transition-colors text-gray-700">
            {t.short}
          </a>
        ))}
      </div>
    </section>
  </article>
</BaseLayout>
