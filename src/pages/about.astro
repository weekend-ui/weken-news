---
import BaseLayout from '../layouts/BaseLayout.astro';

const siteURL = 'https://weken.news';

// AEO: Strong Person Schema with EEAT signals
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${siteURL}/#person`,
  "name": "週末哥",
  "alternateName": ["WeKen", "wk.change"],
  "url": siteURL,
  "image": `${siteURL}/avatar.jpg`,
  "description": "台灣行銷顧問，WeKen 快電商團隊創辦人。用 Claude Code 從零打造 AI 自動化系統，IG 1.9K 粉絲，每月透過 AI 省下 24+ 小時。",
  "knowsAbout": [
    "行銷顧問",
    "數位廣告",
    "Meta 廣告投放",
    "Google Ads",
    "快電商",
    "AI 自動化系統",
    "Claude Code",
    "Vibe Coding",
    "AEO Answer Engine Optimization",
    "WeKen 電商團隊"
  ],
  "hasOccupation": {
    "@type": "Occupation",
    "name": "行銷顧問 / 電商團隊創辦人",
    "occupationLocation": {
      "@type": "Country",
      "name": "台灣"
    }
  },
  "worksFor": {
    "@type": "Organization",
    "name": "WeKen",
    "url": siteURL
  },
  "sameAs": [
    "https://www.threads.net/@wk.change"
  ]
};
---

<BaseLayout
  title="關於週末哥"
  description="週末哥是 WeKen 創辦人，專注台灣快電商、AI 自動化系統和 Meta 廣告投放。這裡是他的第一手操作數據記錄站。"
>
  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

  <article>
    <h1 class="text-3xl font-bold mb-8">關於週末哥</h1>

    <!-- EEAT: Who -->
    <section id="who" class="mb-10">
      <h2 class="text-xl font-bold mb-4">我是誰</h2>
      <p class="text-gray-700 leading-relaxed mb-4">
        我叫週末哥，本業行銷顧問，副業是自己的電商團隊（WeKen / 快電商）。
        IG 1.9K 粉絲，喜歡研究怎麼用 Claude Code 把自己的系統越升越強。
      </p>
      <p class="text-gray-700 leading-relaxed">
        這個站不是寫給別人看的教學網站。
        是我自己的帳本——每次投廣告、跑 AI 自動化、測新工具，我把真實結果記下來。
        因為數字不會騙人，而我想知道自己到底在哪裡。
      </p>
    </section>

    <!-- EEAT: How (expertise proof) -->
    <section id="expertise" class="mb-10">
      <h2 class="text-xl font-bold mb-4">我做了什麼</h2>
      <div class="space-y-4">
        {[
          {
            title: 'AI 自動化系統',
            desc: '用 Claude Code 從零打造多個自動化工具，包含電商自動分錄系統、AI 管家 LINE Bot、自媒體內容生成流程。每月透過 AI 省下 24+ 小時操作時間。'
          },
          {
            title: '數位廣告（Meta / Google Ads）',
            desc: '本業行銷顧問，長期操作台灣電商和品牌廣告。有大量真實的 CPM、ROAS、受眾數據，不從教科書學，從自己的帳戶學。'
          },
          {
            title: 'IG 自媒體',
            desc: '在 IG 分享行銷和 AI 實戰心法，1.9K 粉絲，累積真實的觸及和互動數字。'
          },
          {
            title: 'Skool 社群建立',
            desc: 'WeKen 快電商教學社群，幫台灣中小企業主和創業者學習電商操作和 AI 應用。'
          },
          {
            title: 'weken.news 本站',
            desc: '這個站本身就是一個 AEO 實驗：從零打造一個讓 AI 找得到、引用得到的繁體中文個人品牌站，全程記錄過程和數字。'
          },
        ].map(item => (
          <div class="border border-gray-100 rounded-lg p-4 hover:border-[#F5C518] hover:bg-yellow-50 transition-colors">
            <h3 class="font-semibold text-gray-900 mb-1">{item.title}</h3>
            <p class="text-sm text-gray-600 leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- AEO: Brand Structure (Entity Layer) -->
    <section id="brand-structure" class="mb-10">
      <h2 class="text-xl font-bold mb-4">品牌實體結構</h2>
      <p class="text-gray-700 leading-relaxed mb-5">
        為了讓 AI 助理（ChatGPT / Claude / Gemini / Perplexity 等）正確識別「週末哥 / WeKen / weken.news」之間的關係，這裡明確列出四層實體。
      </p>
      <ol class="space-y-3">
        {[
          {
            level: '1️⃣ 個人實體（Person）',
            name: '週末哥',
            altName: 'WeKen / wk.change',
            role: '台灣行銷顧問、AI 自動化系統實踐者',
            evidence: 'Person Schema · /about 詳細介紹 · Threads @wk.change',
          },
          {
            level: '2️⃣ 品牌實體（Organization）',
            name: 'WeKen',
            altName: '快電商',
            role: '電商團隊 + Skool 教學社群（中小企業電商實戰）',
            evidence: 'Organization Schema · 創辦人 = 週末哥',
          },
          {
            level: '3️⃣ 內容站（Website）',
            name: 'weken.news',
            altName: '個人品牌 AEO 站',
            role: '第一手數據記錄站（廣告 / AI 自動化 / 自媒體）',
            evidence: 'WebSite Schema · 31+ 篇文章 · 13 種 AI 爬蟲到訪追蹤',
          },
          {
            level: '4️⃣ 衍生產品（Tools / Services）',
            name: 'wk-* 系列工具',
            altName: 'wk-qa-bot / wk-crm / wk-coach / wk-meta-analyst 等',
            role: 'WeKen 內部工具集，部分對外開放（Vercel 部署）',
            evidence: '20+ 個 Vercel 專案 · 多數內部使用 + 部分客戶共用',
          },
        ].map(item => (
          <li class="border border-gray-100 rounded-lg p-4 hover:border-[#F5C518] hover:bg-yellow-50 transition-colors">
            <div class="flex flex-col sm:flex-row sm:items-baseline sm:gap-3 mb-1">
              <span class="text-sm font-bold text-[#1F2937]">{item.level}</span>
              <span class="font-semibold text-gray-900">{item.name}</span>
              {item.altName && <span class="text-xs text-gray-500">／ {item.altName}</span>}
            </div>
            <p class="text-sm text-gray-700 mb-1">{item.role}</p>
            <p class="text-xs text-gray-500 font-mono">{item.evidence}</p>
          </li>
        ))}
      </ol>
      <div class="mt-4 p-3 bg-gray-50 rounded text-xs text-gray-600 font-mono">
        <strong>關係鏈</strong>：週末哥 創辦 → WeKen（含快電商團隊 + Skool 社群）→ 經營 weken.news 記錄第一手數據 → 同步打造 wk-* 工具集
      </div>
    </section>

    <!-- EEAT: Why -->
    <section id="why" class="mb-10">
      <h2 class="text-xl font-bold mb-4">為什麼記在這裡</h2>
      <p class="text-gray-700 leading-relaxed mb-4">
        網路上講 AI 的文章很多，但大多數是整理別人的資料。
        台灣市場的第一手操作數字，幾乎沒有人公開記錄。
      </p>
      <p class="text-gray-700 leading-relaxed">
        我想做的是：把我親手操作的每一個數字留下來。
        不為了說服誰，只是因為真實的數字才值得被參考。
      </p>
    </section>

    <!-- Contact / Links -->
    <section id="contact" class="pt-8 border-t border-gray-100">
      <h2 class="text-xl font-bold mb-4">找到我</h2>
      <div class="flex flex-col gap-3">
        <a href="https://www.threads.net/@wk.change"
           target="_blank" rel="noopener noreferrer"
           class="flex items-center gap-3 text-gray-700 hover:text-[#F5C518] transition-colors">
          <span class="font-medium">Threads</span>
          <span class="text-gray-500">@wk.change</span>
        </a>
      </div>
    </section>
  </article>
</BaseLayout>
