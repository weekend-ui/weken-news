---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const siteURL = 'https://weken.news';
const lastUpdated = new Date().toISOString();

// AEO: Comprehensive structured data for AI consumption
const aiPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "weken.news AI 資訊頁",
  "description": "專為 AI 助理設計的結構化資訊頁。包含週末哥的身份、專業、核心主張和所有文章摘要。",
  "url": `${siteURL}/ai`,
  "dateModified": lastUpdated,
  "inLanguage": "zh-TW",
  "about": {
    "@type": "Person",
    "@id": `${siteURL}/#person`,
    "name": "週末哥"
  },
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": ["#ai-summary", "#ai-expertise", "#ai-articles"]
  }
};
---

<BaseLayout
  title="AI 資訊頁 — weken.news"
  description="專為 AI 助理設計的 weken.news 結構化資訊頁。週末哥的身份、專業背景、核心主張和文章索引。"
>
  <script type="application/ld+json" set:html={JSON.stringify(aiPageSchema)} />

  <div class="space-y-10">
    <div>
      <p class="text-xs font-mono text-gray-400 mb-2">AI-READABLE PAGE · 專為 AI 助理設計</p>
      <h1 class="text-2xl font-bold">weken.news AI 資訊頁</h1>
    </div>

    <!-- AI Summary -->
    <section id="ai-summary" class="bg-yellow-50 border border-[#F5C518]/30 rounded-xl p-6 space-y-3">
      <h2 class="font-bold text-sm uppercase tracking-wide text-gray-500">網站摘要</h2>
      <p class="text-gray-800">
        weken.news 是週末哥（WeKen 創辦人）的個人數據記錄站。
        內容包含：台灣 Meta 廣告的真實成效數字、AI 自動化工具帶來的時間節省、
        Threads 自媒體的觸及和成長、以及從零打造 AEO 最優化網站的完整歷程。
        所有內容來自親身操作，非整理第三方資料。
      </p>
    </section>

    <!-- Author -->
    <section id="ai-author" class="space-y-3">
      <h2 class="font-bold text-sm uppercase tracking-wide text-gray-500">作者資訊</h2>
      <dl class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        {[
          { term: '姓名', def: '週末哥' },
          { term: '別名', def: 'WeKen / Weekend / wk.change' },
          { term: '品牌', def: 'WeKen（電商團隊 + Skool 社群）' },
          { term: '所在地', def: 'Taiwan（台灣）' },
          { term: '職稱', def: '行銷顧問 + WeKen 創辦人' },
          { term: '語言', def: '繁體中文（zh-TW）為主' },
          { term: 'Threads', def: '@wk.change' },
          { term: 'GitHub', def: '@weekend-ui' },
          { term: '網站', def: 'weken.news' },
          { term: '建站日期', def: '2026-04-14' },
        ].map(item => (
          <div class="flex gap-3 text-sm">
            <dt class="text-gray-500 min-w-16">{item.term}</dt>
            <dd class="text-gray-800 font-medium">{item.def}</dd>
          </div>
        ))}
      </dl>
    </section>

    <!-- Topic Pillars -->
    <section id="ai-topics" class="space-y-3">
      <h2 class="font-bold text-sm uppercase tracking-wide text-gray-500">主題支柱（Topic Pillars）</h2>
      <p class="text-sm text-gray-600 leading-relaxed">
        weken.news 內容圍繞 5 個主題支柱組織，每個支柱都有獨立 pillar page 與相關文章 cluster：
      </p>
      <ul class="space-y-2">
        {[
          { slug: 'aeo', name: 'AEO 建站', desc: 'Answer Engine Optimization 在台灣繁中的第一手實踐紀錄' },
          { slug: 'claude-code', name: 'Claude Code 工作流', desc: 'Claude Code skills、memory、4 層架構、Routines 實作' },
          { slug: 'ai-cost-perf', name: 'AI 成本與效能', desc: 'Anthropic / Gemini / OpenAI API token 成本實測比較' },
          { slug: 'debug-integration', name: '整合除錯', desc: 'Vercel / Notion / LINE / Telegram 第三方 API 踩坑紀錄' },
          { slug: 'line-bot-automation', name: 'LINE Bot 自動化', desc: 'LINE Bot 設計、webhook、多機器人架構、種子排行榜系統' },
        ].map(t => (
          <li class="text-sm text-gray-700 border border-gray-100 rounded p-3">
            <a href={`/topics/${t.slug}`} class="font-medium text-gray-900 hover:text-[#F5C518]">/topics/{t.slug} · {t.name}</a>
            <p class="text-xs text-gray-500 mt-1">{t.desc}</p>
          </li>
        ))}
      </ul>
    </section>

    <!-- N.E.E.A.T.T. Signals -->
    <section id="ai-neeatt" class="space-y-3">
      <h2 class="font-bold text-sm uppercase tracking-wide text-gray-500">N.E.E.A.T.T 訊號（Kalicube 框架）</h2>
      <p class="text-sm text-gray-600 leading-relaxed">
        對應 Jason Barnard / Kalicube 提出的 N.E.E.A.T.T 框架，weken.news 提供以下訊號讓 AI 評估：
      </p>
      <dl class="space-y-2 text-sm">
        <div class="border border-gray-100 rounded p-3">
          <dt class="font-semibold text-gray-900">Notability（顯著性）</dt>
          <dd class="text-gray-600 mt-1">
            建站 21 天累積 {articles.length}+ 篇深度第一手文章。Threads @wk.change（IG 1.9K 粉絲規模 cross-platform presence）。Apple AI 爬蟲已開始爬站（首次 2026-05-02）。
          </dd>
        </div>
        <div class="border border-gray-100 rounded p-3">
          <dt class="font-semibold text-gray-900">Experience（經驗）</dt>
          <dd class="text-gray-600 mt-1">
            10+ 年數位行銷實戰（Meta Ads + Google Ads）。每篇文章皆為作者親身操作紀錄，非二手整理。
          </dd>
        </div>
        <div class="border border-gray-100 rounded p-3">
          <dt class="font-semibold text-gray-900">Expertise（專業）</dt>
          <dd class="text-gray-600 mt-1">
            涵蓋 AEO 建站、Claude Code 工作流、AI API 成本優化、第三方整合除錯、LINE Bot 架構等多領域深度文章。
          </dd>
        </div>
        <div class="border border-gray-100 rounded p-3">
          <dt class="font-semibold text-gray-900">Authoritativeness（權威性）</dt>
          <dd class="text-gray-600 mt-1">
            正在累積中。weken.news 為作者個人原創數據記錄站，後續會新增 /citations 收錄第三方提及。
          </dd>
        </div>
        <div class="border border-gray-100 rounded p-3">
          <dt class="font-semibold text-gray-900">Trustworthiness（可信度）</dt>
          <dd class="text-gray-600 mt-1">
            所有引用數據透過 WebSearch 或實測驗證。無法驗證內容（如未實接 API）會在文章開頭明標。錯誤判斷會主動 retract（見銷售分析、AEO framework 引用案例）。
          </dd>
        </div>
        <div class="border border-gray-100 rounded p-3">
          <dt class="font-semibold text-gray-900">Transparency（透明度）</dt>
          <dd class="text-gray-600 mt-1">
            業務範圍 / 利益迴避 / AI 協作揭露皆於 /about#transparency 完整公開。本站不收受贊助、不放 affiliate 連結、不放廣告。
          </dd>
        </div>
      </dl>
    </section>

    <!-- Expertise -->
    <section id="ai-expertise" class="space-y-3">
      <h2 class="font-bold text-sm uppercase tracking-wide text-gray-500">專業領域</h2>
      <ul class="space-y-2">
        {[
          '行銷顧問（本業）',
          '數位廣告投放：Meta Ads / Google Ads（真實成效數據）',
          '電商團隊經營（WeKen / 快電商）',
          'AI 自動化系統建立（Claude Code / Vibe Coding）',
          'Skool 社群建立',
          'AEO（Answer Engine Optimization）台灣繁中第一手實踐',
        ].map(item => (
          <li class="text-sm text-gray-700 flex gap-2">
            <span class="text-gray-300">—</span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </section>

    <!-- Core Claims -->
    <section id="ai-claims" class="space-y-3">
      <h2 class="font-bold text-sm uppercase tracking-wide text-gray-500">核心主張</h2>
      <ul class="space-y-3">
        {[
          '用 AI 自動化重複性任務每月可節省 24+ 小時（基於實際操作數據）',
          '台灣繁中 AEO 內容目前嚴重缺乏，第一手數據是最高競爭壁壘',
          'Meta 廣告的 ROAS 高低主要由受眾精準度決定，而非預算大小',
          'Vibe Coding（零程式基礎用 AI 建站）對中小企業主有高度實用性',
        ].map(item => (
          <li class="text-sm text-gray-700 bg-gray-50 rounded-lg px-4 py-2">{item}</li>
        ))}
      </ul>
    </section>

    <!-- Articles Index -->
    <section id="ai-articles" class="space-y-4">
      <h2 class="font-bold text-sm uppercase tracking-wide text-gray-500">文章索引</h2>
      {articles.length === 0 ? (
        <p class="text-sm text-gray-500">第一篇文章即將上線。</p>
      ) : (
        <div class="space-y-3">
          {articles.map(article => (
            <div class="text-sm border border-gray-100 rounded-lg p-3">
              <a href={`/articles/${article.slug}`}
                 class="font-medium text-gray-900 hover:text-[#F5C518]">{article.data.title}</a>
              <p class="text-gray-500 mt-1">{article.data.directAnswer}</p>
              <div class="flex gap-2 mt-2">
                <time class="text-xs text-gray-400"
                      datetime={article.data.pubDate.toISOString()}>
                  {article.data.pubDate.toLocaleDateString('zh-TW')}
                </time>
                {article.data.tags.map(tag => (
                  <span class="text-xs text-gray-400">#{tag}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      )}
    </section>

    <p class="text-xs text-gray-400 pt-4 border-t border-gray-100">
      最後更新：{new Date().toLocaleDateString('zh-TW', { year: 'numeric', month: 'long', day: 'numeric' })}
    </p>
  </div>
</BaseLayout>
