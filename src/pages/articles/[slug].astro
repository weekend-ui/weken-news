---
// SSR（不 prerender），讓 middleware.ts 在每個文章 request 都跑，
// 才能 track AI bot（GPTBot / ChatGPT-User / OAI-SearchBot / etc）訪問記錄。
// 若改回 prerender，middleware 會被 Vercel Edge Cache bypass，AI bot 訪問全部漏記。
//
// SSR mode 不能用 getStaticPaths + Astro.props，要改成從 Astro.params 拿 slug
// 自己 fetch 對應 article。
export const prerender = false;

import { getCollection } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';

const { slug } = Astro.params;
if (!slug) return new Response('Not Found', { status: 404 });

const articles = await getCollection('articles');
const article = articles.find(a => a.slug === slug);
if (!article) return new Response('Not Found', { status: 404 });

const { Content } = await article.render();
---

<ArticleLayout article={article}>
  <Content />
</ArticleLayout>
