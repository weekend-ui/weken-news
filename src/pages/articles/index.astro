---
// SSR（不 prerender），讓 middleware.ts 在 list 頁也 track AI bot 訪問
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const allTags = [...new Set(articles.flatMap(a => a.data.tags))].sort();
---

<BaseLayout
  title="所有文章"
  description="週末哥的第一手數據記錄：Meta 廣告成效、AI 自動化效益、Threads 自媒體數字、AEO 建站歷程。"
>
  <div>
    <h1 class="text-2xl font-bold mb-2">所有文章</h1>
    <p class="text-gray-500 mb-8">共 {articles.length} 篇記錄</p>

    <!-- Tag filters -->
    {allTags.length > 0 && (
      <div class="flex flex-wrap gap-2 mb-8">
        {allTags.map(tag => (
          <span class="text-xs bg-gray-100 text-[#1F2937] px-3 py-1 rounded-full cursor-pointer hover:bg-yellow-50 hover:border-[#F5C518] border border-transparent transition-colors">
            {tag}
          </span>
        ))}
      </div>
    )}

    {articles.length === 0 ? (
      <div class="text-center py-16 text-gray-400">
        <p class="text-lg mb-2">第一篇文章即將上線</p>
        <p class="text-sm">訂閱 RSS 第一時間收到通知</p>
        <a href="/rss.xml" class="text-sm text-[#F5C518] hover:underline mt-2 inline-block">RSS Feed →</a>
      </div>
    ) : (
      <div class="space-y-4">
        {articles.map(article => (
          <a href={`/articles/${article.slug}`} class="block group">
            <article class="border border-gray-100 rounded-xl p-5 hover:border-[#F5C518] hover:bg-yellow-50 transition-colors">
              <div class="flex items-start justify-between gap-4">
                <div class="flex-1 min-w-0">
                  <div class="flex flex-wrap gap-1.5 mb-2">
                    {article.data.tags.slice(0, 3).map(tag => (
                      <span class="text-xs text-gray-500 bg-gray-50 px-2 py-0.5 rounded">{tag}</span>
                    ))}
                  </div>
                  <h2 class="font-bold text-gray-900 group-hover:text-[#F5C518] transition-colors mb-1">
                    {article.data.title}
                  </h2>
                  <p class="text-sm text-gray-600 leading-relaxed line-clamp-2">
                    {article.data.directAnswer}
                  </p>
                </div>
                <time class="text-xs text-gray-400 whitespace-nowrap"
                      datetime={article.data.pubDate.toISOString()}>
                  {article.data.pubDate.toLocaleDateString('zh-TW', { month: 'short', day: 'numeric' })}
                </time>
              </div>
            </article>
          </a>
        ))}
      </div>
    )}
  </div>
</BaseLayout>
