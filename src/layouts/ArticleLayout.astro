---
import BaseLayout from './BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

interface Props {
  article: CollectionEntry<'articles'>;
}

const { article } = Astro.props;
const { title, description, pubDate, updatedDate, tags, directAnswer, faq, howToSteps, speakableSections } = article.data;

// AEO: Auto-related articles by tag overlap (strengthens topic cluster signals)
const allArticles = await getCollection('articles');
const relatedArticles = allArticles
  .filter(a => a.slug !== article.slug)
  .map(a => {
    const overlap = a.data.tags.filter(t => tags.includes(t)).length;
    return { article: a, overlap };
  })
  .filter(x => x.overlap > 0)
  .sort((a, b) => b.overlap - a.overlap || b.article.data.pubDate.valueOf() - a.article.data.pubDate.valueOf())
  .slice(0, 4)
  .map(x => x.article);

const siteURL = 'https://weken.news';
const canonicalURL = `${siteURL}/articles/${article.slug}`;

// AEO: Article Schema with explicit isAuthor / isPublisher relationships
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "@id": `${canonicalURL}#article`,
  "headline": title,
  "description": description,
  "datePublished": pubDate.toISOString(),
  "dateModified": (updatedDate || pubDate).toISOString(),
  "author": {
    "@type": "Person",
    "@id": `${siteURL}/#person`,
    "name": "週末哥",
    "url": `${siteURL}/about`
  },
  "publisher": {
    "@type": "Organization",
    "@id": `${siteURL}/#organization`,
    "name": "WeKen",
    "url": siteURL,
    "logo": {
      "@type": "ImageObject",
      "url": `${siteURL}/logo.png`,
      "width": 512,
      "height": 512
    }
  },
  "image": {
    "@type": "ImageObject",
    "url": `${siteURL}/og-default.png`,
    "width": 1200,
    "height": 630
  },
  "mainEntityOfPage": { "@id": `${canonicalURL}#webpage` },
  "inLanguage": "zh-TW",
  "keywords": tags.join(', '),
  "articleSection": tags[0] || "AEO",
  "url": canonicalURL,
  "isAccessibleForFree": true
};

// AEO: FAQ Schema
const faqSchema = faq.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faq.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
} : null;

// AEO: HowTo Schema
const howToSchema = howToSteps && howToSteps.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": title,
  "description": description,
  "step": howToSteps.map((step, i) => ({
    "@type": "HowToStep",
    "position": i + 1,
    "name": step.name,
    "text": step.text
  }))
} : null;

// AEO: Speakable Schema
const speakableSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": speakableSections.map(s => `#${s}`)
  },
  "url": canonicalURL
};

// AEO: BreadcrumbList
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "首頁", "item": siteURL },
    { "@type": "ListItem", "position": 2, "name": "文章", "item": `${siteURL}/articles` },
    { "@type": "ListItem", "position": 3, "name": title, "item": canonicalURL }
  ]
};
---

<BaseLayout
  title={title}
  description={description}
  canonicalURL={canonicalURL}
  type="article"
  pubDate={pubDate}
  updatedDate={updatedDate}
>
  <!-- AEO: Article-specific Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  {howToSchema && <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />}
  <script type="application/ld+json" set:html={JSON.stringify(speakableSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <article>
    <!-- Breadcrumb -->
    <nav class="text-sm text-gray-500 mb-6" aria-label="breadcrumb">
      <a href="/" class="hover:text-[#F5C518]">首頁</a>
      <span class="mx-2">/</span>
      <a href="/articles" class="hover:text-[#F5C518]">文章</a>
      <span class="mx-2">/</span>
      <span class="text-gray-700">{title}</span>
    </nav>

    <!-- Article Header -->
    <header class="mb-8">
      <div class="flex flex-wrap gap-2 mb-3">
        {tags.map(tag => (
          <span class="text-xs bg-yellow-50 text-[#1F2937] border border-[#F5C518]/40 px-2 py-1 rounded">{tag}</span>
        ))}
      </div>
      <h1 class="text-2xl sm:text-3xl font-bold leading-tight mb-4">{title}</h1>

      <!-- AEO: Direct answer summary - speakable section -->
      <div id="article-summary" class="bg-yellow-50 border-l-4 border-[#F5C518] px-4 py-3 rounded-r text-[#1F2937] text-base leading-relaxed">
        <p class="font-medium text-xs text-gray-500 uppercase tracking-wide mb-1">直接回答</p>
        <p>{directAnswer}</p>
      </div>

      <div class="flex items-center gap-4 mt-4 text-sm text-gray-500">
        <span>週末哥</span>
        <span>·</span>
        <time datetime={pubDate.toISOString()}>
          {pubDate.toLocaleDateString('zh-TW', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
        {updatedDate && (
          <>
            <span>·</span>
            <span>更新：<time datetime={updatedDate.toISOString()}>
              {updatedDate.toLocaleDateString('zh-TW', { year: 'numeric', month: 'long', day: 'numeric' })}
            </time></span>
          </>
        )}
      </div>
    </header>

    <!-- Article Content -->
    <div class="prose prose-gray max-w-none
      prose-headings:font-bold prose-headings:text-gray-900
      prose-p:text-gray-700 prose-p:leading-relaxed
      prose-strong:text-gray-900
      prose-a:text-[#D4AF37] prose-a:no-underline hover:prose-a:underline
      prose-blockquote:border-gray-300 prose-blockquote:text-gray-600
      prose-code:bg-gray-100 prose-code:px-1 prose-code:rounded
      prose-pre:bg-gray-900">
      <slot />
    </div>

    <!-- AEO: FAQ Section - speakable + FAQ Schema -->
    {faq.length > 0 && (
      <section id="article-conclusion" class="mt-12 pt-8 border-t border-gray-100">
        <h2 class="text-xl font-bold mb-6">常見問題</h2>
        <div class="space-y-4">
          {faq.map((item) => (
            <details class="group border border-gray-100 rounded-lg">
              <summary class="cursor-pointer px-4 py-3 font-medium text-gray-800 hover:bg-yellow-50 rounded-lg list-none flex justify-between items-center">
                {item.question}
                <span class="text-gray-400 group-open:rotate-180 transition-transform">▾</span>
              </summary>
              <div class="px-4 pb-3 pt-1 text-gray-600 text-sm leading-relaxed">
                {item.answer}
              </div>
            </details>
          ))}
        </div>
      </section>
    )}

    <!-- Related Articles (Topic Cluster 訊號強化) -->
    {relatedArticles.length > 0 && (
      <aside class="mt-12 pt-8 border-t border-gray-100" aria-label="相關文章">
        <h2 class="text-xl font-bold mb-5">同主題相關文章</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {relatedArticles.map(rel => (
            <a href={`/articles/${rel.slug}`}
               class="block border border-gray-100 rounded-lg p-4 hover:border-[#F5C518] hover:bg-yellow-50 transition-colors">
              <div class="flex flex-wrap gap-1 mb-2">
                {rel.data.tags.filter(t => tags.includes(t)).slice(0, 2).map(tag => (
                  <span class="text-xs text-gray-500 bg-gray-50 px-2 py-0.5 rounded">{tag}</span>
                ))}
              </div>
              <p class="font-medium text-gray-900 text-sm leading-snug mb-1">{rel.data.title}</p>
              <p class="text-xs text-gray-500 line-clamp-2">{rel.data.description}</p>
            </a>
          ))}
        </div>
      </aside>
    )}

    <!-- Author Bio Block (N.E.E.A.T.T 訊號 + Person ↔ Article 關聯強化) -->
    <aside class="mt-12 pt-8 border-t border-gray-100" aria-label="作者資訊">
      <div class="bg-gray-50 rounded-lg p-5 border border-gray-100">
        <div class="flex items-start gap-3 mb-3">
          <div class="w-12 h-12 rounded-full bg-[#1F2937] flex items-center justify-center flex-shrink-0">
            <span class="text-[#F5C518] font-bold text-xl">wk</span>
          </div>
          <div>
            <p class="font-semibold text-gray-900">
              <a href="/about#who" class="hover:text-[#F5C518]">週末哥</a>
            </p>
            <p class="text-xs text-gray-500 mt-1">WeKen 創辦人 · 行銷顧問 · weken.news 站長</p>
          </div>
        </div>
        <p class="text-sm text-gray-700 leading-relaxed mb-3">
          台灣行銷顧問，WeKen 快電商團隊創辦人。本站記錄 AEO 建站、Claude Code 工作流、廣告投放、AI 工具實作的第一手數據。所有內容來自親身操作。
        </p>
        <div class="flex flex-wrap gap-3 text-xs text-gray-500">
          <a href="/about" class="hover:text-[#F5C518]">→ 完整介紹</a>
          <a href="/case-studies" class="hover:text-[#F5C518]">→ 實證案例</a>
          <a href="/positioning" class="hover:text-[#F5C518]">→ 與其他人差異</a>
          <a href="https://www.threads.net/@wk.change" target="_blank" rel="noopener noreferrer" class="hover:text-[#F5C518]">→ Threads @wk.change</a>
        </div>
      </div>
    </aside>
  </article>

  <style is:global>
    .prose .geo-quote {
      background: #FEF9E7;
      border-left: 4px solid #D4AF37;
      border-radius: 0 8px 8px 0;
      padding: 16px 20px;
      margin: 28px 0;
      font-style: normal;
      position: relative;
      quotes: none;
    }
    .prose .geo-quote::before {
      content: '📌 GEO 引用區塊';
      display: block;
      font-size: 11px;
      font-weight: 700;
      color: #92400E;
      letter-spacing: 0.5px;
      margin-bottom: 8px;
    }
    .prose .geo-quote p,
    .prose .geo-quote > div {
      margin: 0;
      color: #1F2937;
      font-weight: 500;
      line-height: 1.7;
      font-size: 0.95em;
    }
    .prose .geo-quote p + p {
      margin-top: 8px;
    }
  </style>
</BaseLayout>
