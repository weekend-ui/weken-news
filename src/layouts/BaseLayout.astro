---
interface Props {
  title: string;
  description: string;
  canonicalURL?: string;
  ogImage?: string;
  type?: 'website' | 'article';
  pubDate?: Date;
  updatedDate?: Date;
}

const {
  title,
  description,
  canonicalURL = Astro.url.href,
  ogImage = '/og-default.png',
  type = 'website',
  pubDate,
  updatedDate,
} = Astro.props;

const siteURL = 'https://weken.news';
const fullTitle = title === '週末哥 | weken.news' ? title : `${title} | 週末哥 weken.news`;

// AEO: Organization + Website + Person combined JSON-LD
const siteSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteURL}/#website`,
      "url": siteURL,
      "name": "weken.news",
      "description": "週末哥的第一手數據記錄：AI 自動化、電商、廣告、自媒體",
      "inLanguage": "zh-TW",
      "publisher": { "@id": `${siteURL}/#person` }
    },
    {
      // Source of truth: ~/.claude/identity.md (Brand Structure Layer 2)
      "@type": "Organization",
      "@id": `${siteURL}/#organization`,
      "name": "WeKen",
      "alternateName": ["週末哥", "快電商", "weken.news"],
      "url": siteURL,
      "description": "WeKen 由週末哥創辦，台灣 AI 自動化 × 快電商 × 行銷實踐團隊。產出 Claude Code 工具、Meta 與 Google 廣告投放、C2CBuy 直播選品、AEO 內容建站的第一手實作數據。",
      "logo": {
        "@type": "ImageObject",
        "url": `${siteURL}/logo.png`,
        "width": 512,
        "height": 512
      },
      "sameAs": [
        "https://www.threads.net/@wk.change",
        "https://github.com/weekend-ui"
      ],
      "founder": { "@id": `${siteURL}/#person` },
      "foundingDate": "2026-04-14",
      "knowsAbout": ["AEO", "Answer Engine Optimization", "AI 自動化", "Claude Code", "Vibe Coding", "Meta 廣告", "Google Ads", "快電商"]
    },
    {
      // Source of truth: ~/.claude/identity.md (Person Entity section)
      "@type": "Person",
      "@id": `${siteURL}/#person`,
      "name": "週末哥",
      "alternateName": ["WeKen", "Weekend", "wk.change"],
      "url": siteURL,
      "image": `${siteURL}/logo.png`,
      "description": "台灣行銷顧問，WeKen 快電商團隊創辦人，AI 自動化系統實踐者。weken.news 站長，記錄 AEO 建站、Claude Code、廣告投放、AI 工具實作的第一手數據。",
      "jobTitle": "行銷顧問與 WeKen 創辦人",
      "knowsAbout": [
        "AEO（Answer Engine Optimization）",
        "AI 自動化",
        "Claude Code",
        "Vibe Coding",
        "Anthropic SDK",
        "Meta 廣告",
        "Google Ads",
        "快電商",
        "結構化資料 / Schema.org",
        "Astro",
        "Vercel",
        "個人品牌",
        "自媒體經營",
        "行銷顧問"
      ],
      "knowsLanguage": ["zh-TW", "en"],
      "nationality": { "@type": "Country", "name": "Taiwan" },
      "sameAs": [
        "https://www.threads.net/@wk.change",
        "https://github.com/weekend-ui"
      ],
      "worksFor": { "@id": `${siteURL}/#organization` }
    },
    {
      "@type": "WebPage",
      "@id": `${canonicalURL}#webpage`,
      "url": canonicalURL,
      "name": fullTitle,
      "description": description,
      "isPartOf": { "@id": `${siteURL}/#website` },
      "about": { "@id": `${siteURL}/#person` },
      "inLanguage": "zh-TW"
    }
  ]
};
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="language" content="zh-TW" />
    <link rel="alternate" hreflang="zh-TW" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteURL}${ogImage}`} />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:site_name" content="weken.news" />
    {pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
    {updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteURL}${ogImage}`} />

    <!-- RSS Feed Discovery (主 feed + 5 個主題子 feed) -->
    <link rel="alternate" type="application/rss+xml" title="weken.news RSS" href="/rss.xml" />
    <link rel="alternate" type="application/rss+xml" title="weken.news AEO 主題 RSS" href="/rss/aeo.xml" />
    <link rel="alternate" type="application/rss+xml" title="weken.news Claude Code 主題 RSS" href="/rss/claude-code.xml" />
    <link rel="alternate" type="application/rss+xml" title="weken.news AI 成本效能 RSS" href="/rss/ai-cost-perf.xml" />
    <link rel="alternate" type="application/rss+xml" title="weken.news 整合除錯 RSS" href="/rss/debug-integration.xml" />
    <link rel="alternate" type="application/rss+xml" title="weken.news LINE Bot 自動化 RSS" href="/rss/line-bot-automation.xml" />

    <!-- AEO: Site-level Schema -->
    <script type="application/ld+json" set:html={JSON.stringify(siteSchema)} />

    <!-- Tailwind via CDN for simplicity -->
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-white text-gray-900 font-sans min-h-screen">
    <header class="sticky top-0 z-10 bg-[#1F2937]">
      <div class="max-w-3xl mx-auto px-4 py-4 flex items-center justify-between">
        <a href="/" class="font-bold text-lg tracking-tight flex items-center gap-2">
          <span class="text-[#F5C518]">weken.news</span>
          <span class="text-xs font-normal text-gray-400 hidden sm:inline">週末哥的數據記錄</span>
        </a>
        <nav class="flex gap-4 sm:gap-5 text-sm text-gray-300 flex-wrap">
          <a href="/articles" class="hover:text-[#F5C518] transition-colors">文章</a>
          <a href="/topics" class="hover:text-[#F5C518] transition-colors">主題</a>
          <a href="/scenarios" class="hover:text-[#F5C518] transition-colors hidden sm:inline">情境</a>
          <a href="/case-studies" class="hover:text-[#F5C518] transition-colors hidden sm:inline">案例</a>
          <a href="/about" class="hover:text-[#F5C518] transition-colors">關於</a>
          <a href="/stats" class="hover:text-[#F5C518] transition-colors">AI 數據</a>
        </nav>
      </div>
    </header>

    <main class="max-w-3xl mx-auto px-4 py-10">
      <slot />
    </main>

    <!-- Central ad banner (fetched from wk-ads.vercel.app, mobile-first, supports image) -->
    <section id="weken-ad" class="hidden px-4 mt-12">
      <div id="weken-ad-card" class="max-w-3xl mx-auto rounded-xl overflow-hidden shadow-sm">
        <a id="weken-ad-img-link" href="#" target="_blank" rel="noopener noreferrer sponsored" class="hidden">
          <img id="weken-ad-img" src="" alt="" class="w-full max-h-72 object-cover" />
        </a>
        <div class="p-5 sm:p-6 flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-5">
          <div class="flex-1 text-center sm:text-left">
            <p id="weken-ad-title" class="text-base sm:text-xl font-bold text-[#1F2937] leading-snug"></p>
            <p id="weken-ad-sub" class="text-sm text-[#1F2937] opacity-80 mt-1 leading-relaxed"></p>
          </div>
          <a id="weken-ad-cta" href="#" target="_blank" rel="noopener noreferrer sponsored"
             class="inline-block bg-[#1F2937] text-[#F5C518] px-5 py-3 rounded-lg font-bold text-sm hover:bg-[#374151] transition-colors whitespace-nowrap text-center"></a>
        </div>
      </div>
    </section>
    <script is:inline>
      (async () => {
        try {
          const r = await fetch('https://wk-ads.vercel.app/api/current');
          if (!r.ok) return;
          const ad = await r.json();
          if (!ad || !ad.active || !ad.title) return;
          const sec = document.getElementById('weken-ad');
          const card = document.getElementById('weken-ad-card');
          card.style.background = ad.accent || '#F5C518';
          const clickUrl = ad.ctaUrl
            ? 'https://wk-ads.vercel.app/api/click?src=weken-news&to=' + encodeURIComponent(ad.ctaUrl)
            : '';
          if (ad.imageUrl) {
            const imgLink = document.getElementById('weken-ad-img-link');
            const img = document.getElementById('weken-ad-img');
            img.src = ad.imageUrl;
            img.onerror = () => imgLink.classList.add('hidden');
            if (clickUrl) { imgLink.href = clickUrl; } else { imgLink.removeAttribute('href'); }
            imgLink.classList.remove('hidden');
          }
          document.getElementById('weken-ad-title').textContent = ad.title;
          const sub = document.getElementById('weken-ad-sub');
          if (ad.subtitle) { sub.textContent = ad.subtitle; } else { sub.style.display = 'none'; }
          const cta = document.getElementById('weken-ad-cta');
          if (ad.ctaText && clickUrl) {
            cta.textContent = ad.ctaText;
            cta.href = clickUrl;
          } else {
            cta.style.display = 'none';
          }
          sec.classList.remove('hidden');
        } catch (e) { /* silent — banner just stays hidden */ }
      })();
    </script>

    <footer class="bg-[#1F2937] mt-20">
      <div class="max-w-3xl mx-auto px-4 py-8 text-sm text-gray-400">
        <div class="flex flex-col sm:flex-row justify-between gap-4">
          <div>
            <p class="font-medium text-[#F5C518]">週末哥 | weken.news</p>
            <p class="mt-1">台灣電商 × AI 自動化 × 廣告投放的第一手數據</p>
          </div>
          <div class="flex flex-col gap-1">
            <a href="https://www.threads.net/@wk.change" target="_blank" rel="noopener noreferrer" class="hover:text-[#F5C518] transition-colors">Threads @wk.change</a>
            <a href="/rss.xml" class="hover:text-[#F5C518] transition-colors">RSS Feed</a>
            <a href="/ai" class="hover:text-[#F5C518] transition-colors">AI 資訊頁</a>
            <a href="/stats" class="hover:text-[#F5C518] transition-colors">AI 爬蟲數據</a>
            <a href="/scenarios" class="hover:text-[#F5C518] transition-colors">情境索引</a>
            <a href="/positioning" class="hover:text-[#F5C518] transition-colors">定位與比較</a>
            <a href="/case-studies" class="hover:text-[#F5C518] transition-colors">案例與實證</a>
            <a href="/topics" class="hover:text-[#F5C518] transition-colors">主題索引</a>
          </div>
        </div>
        <p class="mt-6 text-xs text-gray-500">v1.0 · © 2026 WeKen · weken.news</p>
      </div>
    </footer>
  </body>
</html>
